# ---------------------------------------------------------------------------
# Workspace backend. Without the first two, /workspace renders a setup notice
# and the marketing site is unaffected.
#
# This file is a TEMPLATE and is committed. Put real values in `.env.local`,
# which is gitignored. Supabase → Settings → API has both of these.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by the daily digest cron, which must read across all users.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute URL used in emails. Vercel fills this in from its own env in prod,
# so it's only needed for local dev or a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional. Each feature degrades to an explanatory empty state without its key.
# ---------------------------------------------------------------------------

# Email (Resend). Free tier: 3k/month, 100/day.
RESEND_API_KEY=
RESEND_FROM="TechuilaGuys <workspace@yourdomain.com>"

# Read-only fine-grained PAT: contents:read, pull-requests:read.
GITHUB_TOKEN=

# Notion internal integration token. Share each page with the integration.
NOTION_TOKEN=

# Protects /api/cron/digest. Vercel Cron sends this as a bearer token.
CRON_SECRET=
